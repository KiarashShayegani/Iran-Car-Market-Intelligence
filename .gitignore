artifacts/scalers/*.pkl
artifacts/metadata/*.json
artifacts/metadata/*.joblib

# Keep directory structure
!artifacts/models/.gitkeep
!artifacts/scalers/.gitkeep
!artifacts/metadata/.gitkeep

